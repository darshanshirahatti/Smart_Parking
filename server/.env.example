# Copy this file to server/.env and set the real values locally.
DATABASE_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require
PORT=3001
RESERVATION_GRACE_MINUTES=10
SENSOR_EVENT_TOKEN=replace_with_the_same_random_secret_as_root_env
# Twilio Verify credentials. Keep these private; never commit real credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Comma-separated registered administrator account emails.
ADMIN_EMAILS=
# Comma-separated website origins when the frontend is hosted separately.
CORS_ORIGINS=http://localhost:5173
